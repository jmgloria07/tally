<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/>
	</parent>

	<groupId>app.tally</groupId>
	<artifactId>tally</artifactId>
	<version>0.1.0</version>
	<name>tally</name>
	<description>Self-hosted fitness tracker with a local-LLM coach</description>

	<properties>
		<java.version>21</java.version>
		<discord4j.version>3.3.3</discord4j.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<!-- Discord4J 3.3.3 needs reactor-extra 3.6.x: 3.7 (Boot's managed version) removed reactor.retry,
				     and the gateway login fails with ClassNotFoundException: reactor.retry.Backoff. Remove this pin
				     when Discord4J moves off reactor.retry (see docs/spec/20261122-discord-ingest/post-build.md). -->
				<groupId>io.projectreactor.addons</groupId>
				<artifactId>reactor-extra</artifactId>
				<version>3.6.0</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
		</dependency>
		<dependency>
			<!-- Version managed by Boot so it matches the Hibernate 7 core it ships. -->
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-community-dialects</artifactId>
		</dependency>
		<dependency>
			<!-- Discord log ingestion (discord-ingest E4). Reactor types stay inside app.tally.ingest.discord. -->
			<groupId>com.discord4j</groupId>
			<artifactId>discord4j-core</artifactId>
			<version>${discord4j.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>tally</finalName>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- The Vite build (frontend/dist) is served as static resources. If it has not been
			     built, Maven skips this directory and the jar serves the API only. -->
			<resource>
				<directory>../frontend/dist</directory>
				<targetPath>static</targetPath>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
