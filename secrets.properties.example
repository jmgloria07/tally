# Tally secrets and personal values. Copy this file to secrets.properties (gitignored) and fill in what you use.
# Every key is optional: a blank value keeps that feature off. Any backend secret, for any feature, goes here,
# and its key is listed in this example file in the same change (discord-ingest spec E12).
# Defaults for everything else live in backend/src/main/resources/application.properties.

# --- Discord log ingestion (README: "Logging from Discord") ---
# Bot token from the Discord developer portal (Bot > Reset Token). Blank = ingestion off.
tally.ingest.discord.token=
# The one channel to read. User Settings > Advanced > turn on Developer Mode, then right-click the channel > Copy Channel ID.
tally.ingest.discord.channel-id=
# Comma-separated user IDs allowed to log. Click your avatar at the bottom left > Copy User ID (needs Developer Mode).
tally.ingest.discord.allowed-user-ids=

# --- tally-sandbox skill (the app never reads this key) ---
# Private test channel for the sandbox Tally, never your real log channel. Blank = the sandbox runs without Discord.
sandbox.discord.channel-id=
